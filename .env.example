NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
# combined runs everything together; portal and worker split audio onto a VM
BOT_ROLE=combined
# Required for portal/worker: the same random 32-256 character ASCII secret, no spaces
WORKER_SECRET=
# Worker only: HTTPS URL of the portal (also used as PUBLIC_URL if omitted)
WORKER_URL=
# Bot token from Discord Developer Portal > Bot
DISCORD_TOKEN=
# Application ID and client secret from OAuth2 (secret is not the bot token)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: restrict to this server and register commands there immediately
DISCORD_GUILD_ID=
# Optional: role allowed to control playback from outside the voice channel
DJ_ROLE_ID=
# Set a random secret of at least 32 characters in production
SESSION_SECRET=
# Optional: enables Spotify track links; YouTube needs no API key
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: enables playlists accessible to an authorized Spotify account
# Obtain with npm run spotify:authorize; never commit this token
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_MARKET=US
DATA_DIR=./data
YT_DLP_PATH=yt-dlp
MAX_QUEUE_SIZE=2000
MAX_PLAYLIST_TRACKS=50
MAX_TRACK_DURATION_SEC=3600
IDLE_DISCONNECT_MS=300000
# Set true only for a locked setup page before Discord credentials are ready
SETUP_MODE=false
