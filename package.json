{
  "name": "turntable-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A shared Discord music queue and web song request portal.",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "start": "node src/index.mjs",
